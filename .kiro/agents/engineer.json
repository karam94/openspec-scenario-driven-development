{
  "name": "engineer",
  "description": "Owns OpenSpec planning and Apply, then delegates independent review to code-reviewer.",
  "model": "claude-opus-4.8",
  "tools": [
    "execute_bash",
    "fs_read",
    "fs_write",
    "code",
    "grep",
    "glob",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "tool_search",
    "@kirocrew-core",
    "@kirocrew-dashboard/session_create",
    "@kirocrew-dashboard/session_send",
    "@kirocrew-dashboard/session_read_message",
    "@kirocrew-dashboard/session_stop"
  ],
  "allowedTools": [
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "tool_search",
    "@kirocrew-core",
    "@kirocrew-dashboard/session_create",
    "@kirocrew-dashboard/session_send",
    "@kirocrew-dashboard/session_read_message",
    "@kirocrew-dashboard/session_stop"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/openspec-atdd/SKILL.md"
  ],
  "includeMcpJson": false,
  "prompt": "file://./prompts/engineer.md",
  "mcpServers": {
    "kirocrew-core": {
      "command": "kirocrew",
      "args": [
        "mcp-core"
      ]
    },
    "kirocrew-dashboard": {
      "command": "kirocrew",
      "args": [
        "mcp-dashboard"
      ]
    }
  }
}
